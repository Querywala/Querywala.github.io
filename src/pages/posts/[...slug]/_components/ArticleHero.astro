---
import type { CollectionEntry } from "astro:content";

import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
} = post.data;

const readingTime = Math.max(
  1,
  Math.ceil((post.body?.split(/\s+/).length ?? 0) / 200)
);
---

<section class="mx-auto max-w-4xl">

  <!-- Badge -->

  <div class="mb-5">

    <span class="inline-flex rounded-full border border-accent/20 bg-accent/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent">
      Article
    </span>

  </div>

  <!-- Title -->

  <h1
    style={{ viewTransitionName: toTransitionName(title) }}
    class="text-3xl font-extrabold leading-tight tracking-tight text-foreground md:text-4xl lg:text-5xl"
  >
    {title}
  </h1>

  <!-- Description -->

  {
    description && (
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">
        {description}
      </p>
    )
  }

  <!-- Meta -->

  <div class="mt-8 flex flex-wrap items-center gap-6 border-b border-border pb-8 text-sm text-muted">

    <div>
      <span class="font-semibold text-foreground">
        Published
      </span>

      <div class="mt-1">
        <Datetime
          {pubDatetime}
          {modDatetime}
          {timezone}
          size="sm"
        />
      </div>
    </div>

    <div class="h-8 w-px bg-border"></div>

    <div>
      <span class="font-semibold text-foreground">
        Reading Time
      </span>

      <div class="mt-1">
        {readingTime} min read
      </div>
    </div>

  </div>

  <!-- Tags -->

  {
    tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {
          tags.map(tag => (
            <Tag
              tag={slugifyStr(tag)}
              tagName={tag}
              size="sm"
            />
          ))
        }
      </div>
    )
  }

</section>