---
import { getCollection, type CollectionEntry } from "astro:content";

import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

interface Props {
  currentPost: CollectionEntry<"posts">;
}

interface ScoredPost {
  post: CollectionEntry<"posts">;
  score: number;
}

const { currentPost } = Astro.props;

const posts = await getCollection("posts");

const publishedPosts = getSortedPosts(posts).filter(
  (post: CollectionEntry<"posts">) => post.id !== currentPost.id
);

const currentTags = currentPost.data.tags ?? [];

const scoredPosts: ScoredPost[] = publishedPosts.map(
  (post: CollectionEntry<"posts">) => ({
    post,
    score: (post.data.tags ?? []).filter(tag => currentTags.includes(tag)).length,
  })
);

const relatedPosts = scoredPosts
  .sort((a, b) => b.score - a.score)
  .map(item => item.post)
  .slice(0, 3);
---

{
  relatedPosts.length > 0 && (
    <section class="mt-20">

      <div class="mb-8">

        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">
          Continue Reading
        </p>

        <h2 class="mt-2 text-3xl font-black">
          Related Articles
        </h2>

      </div>

      <ul class="grid gap-8 md:grid-cols-3">
        {relatedPosts.map(post => (
          <Card {...post} />
        ))}
      </ul>

    </section>
  )
}