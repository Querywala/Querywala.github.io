---
---

<section class="mt-20 rounded-3xl border border-border bg-surface p-8">

  <div class="flex flex-col gap-8 md:flex-row md:items-start">

    <!-- Avatar -->

    <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-accent text-3xl font-black text-white">
      AG
    </div>

    <!-- Content -->

    <div class="flex-1">

      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">
        About the Author
      </p>

      <h2 class="mt-3 text-3xl font-black">
        Abhishek Gautam
      </h2>

      <p class="mt-2 text-lg text-muted">
        Data & Analytics Manager
      </p>

      <p class="mt-6 max-w-3xl leading-8 text-muted">
        I write about Microsoft Fabric, Azure, SQL, Power BI,
        Artificial Intelligence and Enterprise Data Engineering.
        Every article is based on practical implementation
        experience, production deployments and real-world
        architecture rather than sample projects.
      </p>

      <!-- Technologies -->

      <div class="mt-8 flex flex-wrap gap-3">

        {
          [
            "Microsoft Fabric",
            "Azure",
            "SQL",
            "Power BI",
            "Python",
            "AI",
          ].map(skill => (
            <span
              class="rounded-full border border-accent/20 bg-accent/10 px-4 py-2 text-sm font-medium text-accent"
            >
              {skill}
            </span>
          ))
        }

      </div>

      <!-- Buttons -->

      <div class="mt-10 flex flex-wrap gap-4">

        <a
          href="https://www.linkedin.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-border px-5 py-3 font-semibold transition hover:border-accent hover:text-accent"
        >
          LinkedIn
        </a>

        <a
          href="https://github.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-border px-5 py-3 font-semibold transition hover:border-accent hover:text-accent"
        >
          GitHub
        </a>

        <a
          href="/about"
          class="rounded-xl bg-accent px-5 py-3 font-semibold text-white transition hover:opacity-90"
        >
          About Me
        </a>

      </div>

    </div>

  </div>

</section>