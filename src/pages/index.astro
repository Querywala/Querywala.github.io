---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

import Hero from "@/components/home/Hero.astro";
import FeaturedGuide from "@/components/home/FeaturedGuide.astro";
import LatestArticles from "@/components/home/LatestArticles.astro";
import Topics from "@/components/home/Topics.astro";
// import AboutQuerywala from "@/components/home/AboutQuerywala.astro";
// import FollowSection from "@/components/home/FollowSection.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");

const sortedPosts = getSortedPosts(posts);

const featuredPosts = sortedPosts.filter(
  ({ data }) => data.featured
);

const latestPosts = sortedPosts.filter(
  ({ data }) => !data.featured
);

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>

  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
  >

    <Hero />

    <FeaturedGuide
      posts={featuredPosts}
    />

    <LatestArticles
      posts={latestPosts.slice(0, postsConfig.perIndex)}
    />

    <Topics />

    <!-- <AboutQuerywala /> -->

    <!-- <FollowSection /> -->

  </main>

  <Footer />

</Layout>

<script>
document.addEventListener("astro:page-load", () => {
  const indexLayout = document.querySelector("#main-content");

  const baseRoot =
    import.meta.env.BASE_URL.replace(/\/?$/, "/");

  if (
    indexLayout instanceof HTMLElement &&
    indexLayout.dataset.layout
  ) {
    sessionStorage.setItem(
      "backUrl",
      indexLayout.dataset.homePath ?? baseRoot
    );
  }
});
</script>