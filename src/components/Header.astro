---
import QuerywalaLogo from "@/assets/Querywala-logo.png";
import { getRelativeLocaleUrl } from "astro:i18n";

import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";

import LinkButton from "./LinkButton.astro";

import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);

const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(Boolean);
  const pathArray = path.split("/").filter(Boolean);

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute left-6 -top-20 z-50 rounded-lg bg-accent px-4 py-2 text-white transition-all focus:top-6"
>
  {t.a11y.skipToContent}
</a>

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-lg">

  <div class="mx-auto flex h-20 w-full max-w-7xl items-center justify-between px-6">

    <!-- Logo -->

    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="flex items-center gap-4 transition-opacity hover:opacity-90"
    >
      <img
        src={QuerywalaLogo.src}
        alt="Querywala"
        class="h-14 w-14 object-contain"
      />
    </a>

    <!-- Desktop Navigation -->

    <nav class="hidden items-center gap-10 md:flex">

      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "text-sm font-semibold transition-colors hover:text-accent",
          { "text-accent": isActive("/posts") },
        ]}
      >
        Articles
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "text-sm font-semibold transition-colors hover:text-accent",
          { "text-accent": isActive("/tags") },
        ]}
      >
        Topics
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "text-sm font-semibold transition-colors hover:text-accent",
          { "text-accent": isActive("/about") },
        ]}
      >
        About
      </a>

      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class="relative size-9"
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="absolute inset-0 m-auto size-5" />

            {isActive("/archives") && (
              <IconUnderline class="absolute -bottom-1 left-1/2 w-5 -translate-x-1/2" />
            )}
          </LinkButton>
        )
      }

      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class="relative size-9"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="absolute inset-0 m-auto size-5" />

            {isActive("/search") && (
              <IconUnderline class="absolute -bottom-1 left-1/2 w-5 -translate-x-1/2" />
            )}
          </LinkButton>
        )
      }
            {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="relative flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:bg-muted"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute h-5 w-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute h-5 w-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }

    </nav>

    <!-- Mobile Menu Button -->

    <button
      id="mobile-menu-btn"
      class="flex h-10 w-10 items-center justify-center rounded-lg transition-colors hover:bg-muted md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <IconMenuDeep
        id="menu-open-icon"
        class="h-6 w-6"
      />

      <IconX
        id="menu-close-icon"
        class="hidden h-6 w-6"
      />
    </button>

  </div>

  <!-- Mobile Navigation -->

  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-background md:hidden"
  >

    <div class="mx-auto flex max-w-7xl flex-col px-6 py-5">

      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "rounded-lg px-3 py-3 font-medium transition-colors hover:bg-muted",
          { "text-accent": isActive("/posts") },
        ]}
      >
        Articles
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "rounded-lg px-3 py-3 font-medium transition-colors hover:bg-muted",
          { "text-accent": isActive("/tags") },
        ]}
      >
        Topics
      </a>

      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "rounded-lg px-3 py-3 font-medium transition-colors hover:bg-muted",
          { "text-accent": isActive("/about") },
        ]}
      >
        About
      </a>

      {
        features.showArchives && (
          <a
            href={getRelativeLocaleUrl(locale, "archives")}
            class="rounded-lg px-3 py-3 font-medium transition-colors hover:bg-muted"
          >
            Archives
          </a>
        )
      }

      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="rounded-lg px-3 py-3 font-medium transition-colors hover:bg-muted"
          >
            Search
          </a>
        )
      }

    </div>

  </nav>

</header>

<script>
  function initHeader() {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const openIcon = document.getElementById("menu-open-icon");
    const closeIcon = document.getElementById("menu-close-icon");

    if (
      !menuBtn ||
      !mobileMenu ||
      !openIcon ||
      !closeIcon
    ) {
      return;
    }

    // Prevent duplicate listeners after Astro page transitions
    if ((menuBtn as HTMLButtonElement).dataset.initialized === "true") {
      return;
    }

    (menuBtn as HTMLButtonElement).dataset.initialized = "true";

    menuBtn.addEventListener("click", () => {
      const expanded =
        menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute(
        "aria-expanded",
        expanded ? "false" : "true"
      );

      mobileMenu.classList.toggle("hidden");

      openIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>