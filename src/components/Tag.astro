---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group inline-flex items-center gap-2 rounded-full",
      "border border-border",
      "bg-surface px-4 py-2",
      "transition-all duration-200",
      "hover:-translate-y-0.5",
      "hover:border-accent",
      "hover:bg-accent",
      "hover:text-white",
      "hover:shadow-lg",
      "focus:outline-none",
      "focus:ring-2",
      "focus:ring-accent/30",
      {
        "text-sm px-3 py-1.5": size === "sm",
      },
      {
        "text-base font-medium": size === "lg",
      },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-70 transition-opacity group-hover:opacity-100",
        {
          "size-4": size === "sm",
        },
        {
          "size-5": size === "lg",
        },
      ]}
    />

    <span>{tagName}</span>
  </a>
</li>