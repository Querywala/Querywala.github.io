---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const topics = [
  {
    title: "Microsoft Fabric",
    description: "Lakehouse, Data Warehouse, OneLake, Pipelines, Spark, Real-Time Intelligence",
    href: getRelativeLocaleUrl(locale, "tags/microsoft-fabric"),
    icon: "",
  },
  {
    title: "Power BI",
    description: "Dashboards, DAX, Semantic Models, Performance Optimization",
    href: getRelativeLocaleUrl(locale, "tags/power-bi"),
    icon: "",
  },
  {
    title: "Azure",
    description: "ADF, Synapse, Azure SQL, Storage, Cloud Architecture",
    href: getRelativeLocaleUrl(locale, "tags/azure"),
    icon: "",
  },
  {
    title: "SQL",
    description: "T-SQL, Performance Tuning, Stored Procedures, Data Warehousing",
    href: getRelativeLocaleUrl(locale, "tags/sql"),
    icon: "",
  },
  {
    title: "Python",
    description: "PySpark, Automation, APIs, Data Processing",
    href: getRelativeLocaleUrl(locale, "tags/python"),
    icon: "",
  },
  {
    title: "AI",
    description: "Copilot, AI Agents, LLMs, Enterprise AI",
    href: getRelativeLocaleUrl(locale, "tags/ai"),
    icon: "",
  },
];
---

<section class="mx-auto max-w-7xl border-t border-border px-6 py-24">

  <div class="mb-14 text-center">

    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
      Browse by Topic
    </p>

    <h2 class="mt-3 text-4xl font-black tracking-tight">
      Explore Technologies
    </h2>

    <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-muted">
      Whether you're building enterprise data platforms, optimizing Power BI,
      implementing Microsoft Fabric, or automating workflows with Python,
      you'll find practical, production-ready guidance here.
    </p>

  </div>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">

    {
      topics.map((topic) => (
        <a
          href={topic.href}
          class="group rounded-2xl border border-border bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:shadow-lg"
        >
          <div class="text-4xl">
            {topic.icon}
          </div>

          <h3 class="mt-5 text-2xl font-bold group-hover:text-accent">
            {topic.title}
          </h3>

          <p class="mt-4 leading-7 text-muted">
            {topic.description}
          </p>

          <div class="mt-6 font-semibold text-accent">
            Explore →
          </div>
        </a>
      ))
    }

  </div>

</section>