---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<section class="mx-auto max-w-7xl border-t border-border px-6 py-24">

  <div class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">

    <div>

      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
        Latest Articles
      </p>

      <h2 class="mt-3 text-4xl font-black tracking-tight">
        Learn Something New
      </h2>

      <p class="mt-4 max-w-3xl text-lg leading-8 text-muted">
        Practical tutorials, architecture guides, implementation walkthroughs,
        troubleshooting tips, and production-ready solutions covering Microsoft
        Fabric, Azure, SQL, Power BI, AI, and modern data engineering.
      </p>

    </div>

    <div>

      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        View All Articles
        <IconArrowRight class="ml-2 inline-block" />
      </LinkButton>

    </div>

  </div>

  <ul class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">

    {
      posts.map(post => (
        <li>
          <Card {...post} variant="h3" />
        </li>
      ))
    }

  </ul>

</section>