---
import Socials from "@/components/Socials.astro";
import config from "@/config";

const { socials } = config;
---

<section class="border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-24 text-center">

    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
      Let's Connect
    </p>

    <h2 class="mt-4 text-5xl font-black tracking-tight">
      Continue the conversation.
    </h2>

    <p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-muted">
      If you enjoy practical Microsoft Fabric, Azure, SQL and Power BI
      content, follow Querywala for new tutorials, implementation guides,
      architecture articles and engineering best practices.
    </p>

    {
      socials.length > 0 && (
        <div class="mt-12 flex justify-center">
          <Socials />
        </div>
      )
    }
