---
import type { CollectionEntry } from "astro:content";
import Card from "@/components/Card.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;

const featuredPost = posts[0];
---

{
  featuredPost && (
    <section class="mx-auto max-w-7xl border-t border-border px-6 py-24">

      <div class="mb-12 flex items-end justify-between">

        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-accent">
            Featured
          </p>

          <h2 class="mt-3 text-4xl font-black tracking-tight">
            Start Here
          </h2>

          <p class="mt-4 max-w-2xl text-lg text-muted">
            If you're new to Querywala, this is the best place to begin. Our recommended deep dive covering architecture, implementation and best practices.
          </p>
        </div>

      </div>

      <div class="rounded-3xl border border-border bg-surface p-4 md:p-8">

        <Card
          {...featuredPost}
          variant="h2"
        />

      </div>

    </section>
  )
}